      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/appointments/delete/{{appointmentWithPrescriptionId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "appointments",
            "delete",
            "{{appointmentWithPrescriptionId}}"
          ]
        },
        "description": "Expected 409 if appointment still has prescriptions. Delete its prescriptions first to allow deletion."
      }
    },
