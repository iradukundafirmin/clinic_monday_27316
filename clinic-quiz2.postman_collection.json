  "item": [
    {
      "name": "A1",
      "request": {
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/doctors/{{doctorId}}/specializations/{{specializationIdToAdd}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "doctors",
            "{{doctorId}}",
            "specializations",
            "{{specializationIdToAdd}}"
          ]
        },
        "description": "Add specialization to a doctor. Expected 200; use existing UUIDs. Repeat to test 409."
      }
    },
    {
      "name": "A2",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/doctors/{{doctorId}}/specializations/{{specializationIdToRemove}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "doctors",
            "{{doctorId}}",
            "specializations",
            "{{specializationIdToRemove}}"
          ]
        },
        "description": "Remove only the doctor-specialization link. Expected 200; test missing IDs and absent link for errors."
      }
    },
    {
      "name": "A3",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/offices/free",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "offices",
            "free"
          ]
        },
        "description": "Returns offices without a doctor, sorted by office number. Seed office 104 as free."
      }
    },
    {
      "name": "A4",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/doctors/{{doctorId}}/office?officeNumber=104",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "doctors",
            "{{doctorId}}",
            "office"
          ],
          "query": [
            {
              "key": "officeNumber",
              "value": "104"
            }
          ]
        },
        "description": "Move doctor to office 104. It must be free; afterwards check A3 to see old office is free."
      }
    },
    {
      "name": "B1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/appointments/save",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "appointments",
            "save"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"appointmentDate\": \"2026-10-31\",\n  \"reason\": \"Safe booking test\",\n  \"status\": \"COMPLETED\",\n  \"patient\": {\n    \"id\": \"{{patientId}}\"\n  },\n  \"doctor\": {\n    \"id\": \"{{doctorId}}\"\n  }\n}"
        },
        "description": "Safe booking: rejects past dates and forces new appointments to SCHEDULED. Pick a date the doctor is not booked."
      }
    },
    {
      "name": "B2",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}/status?status=CONFIRMED",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "appointments",
            "{{appointmentId}}",
            "status"
          ],
          "query": [
            {
              "key": "status",
              "value": "CONFIRMED"
            }
          ]
        },
        "description": "Change appointment status. Change status query value to CONFIRMED, CANCELLED, or COMPLETED to test allowed and rejected transitions."
      }
    },
    {
      "name": "B3",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}/reschedule?newDate=2026-10-30",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "appointments",
            "{{appointmentId}}",
            "reschedule"
          ],
          "query": [
            {
              "key": "newDate",
              "value": "2026-10-30"
            }
          ]
        },
        "description": "Reschedule a non-final appointment to a future date that is not already booked by its doctor."
      }
    },
    {
      "name": "C1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/prescriptions/save?appointmentId={{completedAppointmentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "prescriptions",
            "save"
          ],
          "query": [
            {
              "key": "appointmentId",
              "value": "{{completedAppointmentId}}"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"medicineName\": \"Amoxicillin\",\n  \"dosage\": \"1 tablet, 3 times a day\",\n  \"durationDays\": 7\n}"
        },
        "description": "Use a COMPLETED appointment UUID. Expected 201 and \u201cPrescription saved successfully\u201d."
      }
    },
    {
      "name": "C2",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
