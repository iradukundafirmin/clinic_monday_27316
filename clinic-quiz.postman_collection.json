  "item": [
    {
      "name": "Setup - Discover IDs",
      "item": [
        {
          "name": "Get doctors and store first doctor ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/doctors/all",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "doctors",
                "all"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.expect(data).to.be.an(\"array\");",
                  "if (data.length) pm.collectionVariables.set(\"doctorId\", data[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get patients and store first patient ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/patients/all",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "patients",
                "all"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.expect(data).to.be.an(\"array\");",
                  "if (data.length) pm.collectionVariables.set(\"patientId\", data[0].id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "A - Derived queries and double booking",
      "item": [
        {
          "name": "A1 Patients by last name",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/patients/by-last-name?lastName=uwase",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "patients",
                "by-last-name?lastName=uwase"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data=pm.response.json();",
                  "pm.expect(data).to.be.an(\"array\");",
                  "for(let i=1;i<data.length;i++) pm.expect(data[i-1].firstName.toLowerCase() <= data[i].firstName.toLowerCase()).to.eql(true);"
                ]
              }
            }
          ]
        },
        {
          "name": "A2 Appointments by status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/by-status?status=SCHEDULED",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments",
                "by-status?status=SCHEDULED"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data=pm.response.json();",
                  "pm.expect(data).to.be.an(\"array\");",
                  "for(const a of data) pm.expect(a.status).to.eql(\"SCHEDULED\");",
                  "for(let i=1;i<data.length;i++) pm.expect(data[i-1].appointmentDate <= data[i].appointmentDate).to.eql(true);"
                ]
              }
            }
          ]
        },
        {
          "name": "A3 Appointments between inclusive dates",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/between?start=2026-10-01&end=2026-10-31",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments",
                "between?start=2026-10-01&end=2026-10-31"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data=pm.response.json();",
                  "pm.expect(data).to.be.an(\"array\");",
                  "for(const a of data){pm.expect(a.appointmentDate >= \"2026-10-01\").to.eql(true);pm.expect(a.appointmentDate <= \"2026-10-31\").to.eql(true);}",
                  "for(let i=1;i<data.length;i++) pm.expect(data[i-1].appointmentDate <= data[i].appointmentDate).to.eql(true);"
                ]
              }
            }
          ]
        },
        {
          "name": "A4 Double booking returns 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/save",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments",
                "save"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentDate\": \"2026-10-15\",\n  \"reason\": \"Double booking test\",\n  \"status\": \"SCHEDULED\",\n  \"patient\": {\n    \"id\": \"{{patientId}}\"\n  },\n  \"doctor\": {\n    \"id\": \"{{doctorId}}\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
                  "pm.expect(pm.response.text()).to.eql(\"Doctor is already booked on that date\");"
                ]
              }
            }
          ]
        }
      ]
    },
